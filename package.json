{
  "name": "grainlift-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "A Grainlift ADBC gateway on Cloudflare Workers for Durable Objects and D1 databases",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply grainlift-example --local",
    "db:migrate": "wrangler d1 migrations apply grainlift-example --remote",
    "typecheck": "tsc --noEmit",
    "test:blog-demo": "node tests/blog-demo.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "@query-farm/grainlift": "github:Query-farm/grainlift-typescript#0ea316b138e662bb2630a8b07fba68e97909a5ca"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "esbuild": "0.28.1",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "^4.145.0"
  }
}
