{
  // A Grainlift ADBC gateway serving a D1 database. See README.md.
  "name": "grainlift-d1-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // AsyncLocalStorage, node:crypto and Buffer, used by @query-farm/grainlift.
  "compatibility_flags": ["nodejs_compat"],
  // The sample-data migration is also bundled, to seed the `sqlite` target.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grainlift-example",
      "database_id": "f2cfe241-6b87-4665-b83e-e7d06f8d3994",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "GrainliftGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrainliftGateway"] }],
  "vars": {
    "PUBLIC_URL": "https://grainlift-d1-example.rusty-bb6.workers.dev",
    // Cupola, the browser client allowed to call the gateway.
    "CORS_ORIGIN": "https://cupola.query-farm.services",
    // Requests up to 16 MiB, so a row near the stores' 8 MiB limit fits.
    "REQUEST_BYTES": "16777216",
    // Google sign-in (see README). The GOOGLE_CLIENT_SECRET secret and the
    // ALLOWED_EMAILS / ALLOWED_DOMAINS allowlist (secrets here, or vars) complete it.
    "GOOGLE_CLIENT_ID": "639014129284-9kogcob2eedl4o2ualcakfgk5l24qqfe.apps.googleusercontent.com",
    // The device-flow client for command-line sign-in (secret: GOOGLE_DEVICE_CLIENT_SECRET).
    "GOOGLE_DEVICE_CLIENT_ID": "639014129284-qrj9d9ph9ohjcek7foauf71rsbpu7tb0.apps.googleusercontent.com"
  },
  "observability": { "enabled": true },
  "env": {
    // `wrangler deploy --env public`: the same gateway on its own copy of the
    // data, open to anyone (no sign-in). Set READ_ONLY to refuse writes.
    "public": {
      "name": "grainlift-d1-public",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "grainlift-example-public",
          "database_id": "27963620-cb8c-4746-a102-8bd438ab92a8",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "GATEWAY", "class_name": "GrainliftGateway" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GrainliftGateway"] }],
      "vars": {
        "PUBLIC_URL": "https://grainlift-d1-public.rusty-bb6.workers.dev",
        "CORS_ORIGIN": "https://cupola.query-farm.services",
        "ALLOW_ANONYMOUS": "true",
        "REQUEST_BYTES": "16777216"
      }
    }
  }
}
